# Copy to .env and adjust as needed.

# Database (Docker Postgres — see docker-compose.yml)
DATABASE_URL="postgresql://engboost:engboost@localhost:5433/engboost?schema=public"

# AI keys — all optional. You can also set these in the app at /settings (stored in DB).
# A key set in Settings takes priority; these env vars are a fallback.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Auth session secret — generate with: openssl rand -hex 32
AUTH_SECRET=""
